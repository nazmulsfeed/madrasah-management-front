<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /public-homework (without hash) to /#/public-homework for HashRouter
  RewriteRule ^public-homework$ /#/public-homework [R=301,L]

  # Proxy API requests to Node.js backend running on port 30170
  RewriteRule ^api/(.*) http://127.0.0.1:30170/api/$1 [P,L]

  # Route all other requests to index.html (React Router)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
