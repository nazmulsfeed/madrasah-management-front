<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Redirect all HTTP traffic to HTTPS EXCEPT for ZKTeco hardware push routes (/iclock)
  RewriteCond %{HTTPS} off
  RewriteCond %{REQUEST_URI} !^/iclock [NC]
  RewriteCond %{REQUEST_URI} !^/api/v1/attendance/iclock [NC]
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Let Passenger handle /api requests without any interference
  RewriteRule ^api/ - [L]

  # 1.1 Proxy/Rewrite /iclock requests to the Node.js API route
  RewriteRule ^iclock/(.*)$ /api/v1/attendance/iclock/$1 [PT,L]
  RewriteRule ^iclock$ /api/v1/attendance/iclock/cdata [PT,L]

  # 2. Route all other requests to index.html (React Router)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Cache-Control headers to prevent mobile/Android stale caching
<IfModule mod_headers.c>
  # 1. Disable caching for HTML files and root index
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Aggressively cache Vite hashed assets (JS/CSS/Fonts/Images have cache-busting hashes)
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 3. Explicitly NEVER cache Service Worker, Manifest, and robots
  <FilesMatch "(sw\.js|service-worker\.js|manifest\.json|robots\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Fix MIME types for JavaScript and CSS
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript text/css text/html
</IfModule>
