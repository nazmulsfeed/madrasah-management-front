<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset="utf-8">
<title>An-Nur Islamic Academy - Official Letterhead</title>
<!--[if gte mso 9]>
<xml>
 <w:WordDocument>
  <w:View>Print</w:View>
  <w:Zoom>100</w:Zoom>
  <w:DoNotOptimizeForBrowser/>
 </w:WordDocument>
</xml>
<![endif]-->
<style>
@page Section1 {
  size: 595.3pt 841.9pt; /* A4 */
  margin: 36pt 45pt 45pt 45pt;
  mso-header-margin: 36pt;
  mso-footer-margin: 36pt;
  mso-paper-source: 0;
}
div.Section1 {
  page: Section1;
}
body {
  font-family: 'Calibri', 'Segoe UI', 'SolaimanLipi', sans-serif;
  font-size: 11pt;
  color: #0f172a;
}
table.header-table {
  width: 100%;
  border-collapse: collapse;
}
</style>
</head>
<body>
<div class="Section1">
<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>An-Nur Islamic Academy - Official Blank Letterhead</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 6mm 10mm 12mm 10mm;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'Noto Sans Bengali', 'Hind Siliguri', 'SolaimanLipi', -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background: #ffffff;
      color: #0f172a;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    .letterhead-container {
      width: 100%;
      min-height: 279mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 420px;
      height: 420px;
      opacity: 0.07;
      z-index: 0;
      pointer-events: none;
    }
    .header-content {
      position: relative;
      z-index: 10;
      width: 100%;
    }
    .header-top-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      width: 100%;
      margin-bottom: 12px;
    }
    .header-top-left {
      /* Empty balanced space */
    }
    .header-top-center {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 0 8px;
    }
    .header-arabic-img {
      height: 68px;
      max-width: 440px;
      width: auto;
      object-fit: contain;
      display: block;
    }
    .header-top-right {
      display: flex;
      justify-content: flex-end;
      align-items: center;
    }
    .slogan-highlight-box {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f8fafc 100%);
      border: 1px solid #86efac;
      border-right: 3.5px solid #059669;
      border-radius: 6px;
      padding: 2.5px 9px;
      box-shadow: 0 1.5px 3px rgba(0, 0, 0, 0.05);
      line-height: 1.3;
    }
    .slogan-text-line {
      font-size: 10px;
      font-weight: 700;
      color: #065f46;
      white-space: nowrap;
    }
    .header-columns {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      gap: 14px;
      width: 100%;
    }
    .col-left {
      text-align: left;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .col-left .inst-title {
      font-size: 17.5px;
      font-weight: 800;
      color: #020617;
      margin: 0;
      padding: 0;
      height: 24px;
      line-height: 24px;
      white-space: nowrap;
    }
    .col-left .inst-sub,
    .col-left .inst-city {
      font-size: 11.5px;
      color: #1e293b;
      font-weight: 600;
      margin: 0;
      padding: 0;
      height: 17px;
      line-height: 17px;
      white-space: nowrap;
    }
    .col-center {
      display: flex;
      justify-content: center;
      align-items: center;
      align-self: center;
      padding: 0 4px;
    }
    .header-logo-center {
      width: 118px;
      height: 118px;
      object-fit: contain;
    }
    .col-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .col-right .inst-title-en {
      font-family: 'Times New Roman', serif;
      font-size: 16.5px;
      font-weight: 800;
      color: #020617;
      margin: 0;
      padding: 0;
      height: 24px;
      line-height: 24px;
      white-space: nowrap;
    }
    .col-right .inst-sub-en,
    .col-right .inst-city-en {
      font-size: 11.5px;
      color: #1e293b;
      font-weight: 600;
      margin: 0;
      padding: 0;
      height: 17px;
      line-height: 17px;
      white-space: nowrap;
    }
    .inst-line-spacer {
      height: 6px;
      width: 100%;
    }
    .inst-board-line {
      font-size: 10.5px;
      color: #334155;
      font-weight: 500;
      margin: 0;
      padding: 0;
      height: 16px;
      line-height: 16px;
      white-space: nowrap;
    }
    .phone-badge-single {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2.5px 10px;
      background: #f1f5f9;
      color: #047857;
      font-weight: 700;
      font-size: 10.5px;
      border-radius: 4px;
      border: 1px solid #cbd5e1;
      height: 22px;
      white-space: nowrap;
      margin-top: 2px;
    }
    .header-double-divider {
      border-bottom: 2px solid #0f172a;
      margin-top: 8px;
      margin-bottom: 12px;
    }
    .editable-body {
      flex: 1 1 auto;
      min-height: 150mm;
      padding: 20px 0;
      position: relative;
      z-index: 10;
    }
    .footer-signatures {
      margin-top: auto;
      padding-top: 24px;
      width: 100%;
      position: relative;
      z-index: 10;
    }
    .sig-grid {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
    }
    .sig-col {
      flex: 1;
      text-align: center;
    }
    .sig-line {
      border-top: 1.5px solid #334155;
      padding-top: 4px;
      font-weight: 700;
      font-size: 12px;
      color: #0f172a;
      max-width: 200px;
      margin: 0 auto;
    }
    .sig-sub {
      font-size: 11px;
      color: #64748b;
      margin-top: 2px;
    }
  </style>
</head>
<body>
  <div class="letterhead-container">
    <img src="data:image/png;base64," class="watermark" alt="Watermark" />
    
    <div class="header-content">
      <header class="official-header">
        <div class="header-top-row">
          <div class="header-top-left"></div>
          <div class="header-top-center">
            <img src="data:image/png;base64," alt="Arabic Title" class="header-arabic-img" />
          </div>
          <div class="header-top-right">
            <div class="slogan-highlight-box">
              <div class="slogan-text-line">❝ ইলম শিখো, আমল করো,</div>
              <div class="slogan-text-line">মানুষের সেবায় নিজেকে গড়ো। ❞</div>
            </div>
          </div>
        </div>

        <div class="header-columns">
          <div class="col-left">
            <div class="inst-title">আন্-নূর ইসলামিক একাডেমি</div>
            <div class="inst-sub">শাহীবাগ জামে মসজিদ সংলগ্ন,</div>
            <div class="inst-city">চাঁপাইনবাবগঞ্জ।</div>
            <div class="inst-line-spacer"></div>
            <div class="inst-board-line">হুফফাজুল কুরআন ফাউন্ডেশন</div>
            <div class="inst-board-line">বাংলাদেশ হিফজ শিক্ষা বোর্ড (নিবন্ধন: ৫০০৮২৫)</div>
            <div class="inst-line-spacer"></div>
            <div class="phone-badge-single">০১৭৬৭৬১৫৭৪৬ (পরিচালক)</div>
          </div>

          <div class="col-center">
            <img src="data:image/png;base64," alt="Logo" class="header-logo-center" />
          </div>

          <div class="col-right">
            <div class="inst-title-en">AN-NUR ISLAMIC ACADEMY</div>
            <div class="inst-sub-en">Adjacent to Shahibag Jame Mosque</div>
            <div class="inst-city-en">Chapainawabganj.</div>
            <div class="inst-line-spacer"></div>
            <div class="inst-board-line">তানযীম বোর্ড-নিবন্ধন নং: ৪২০৭</div>
            <div class="inst-board-line">নূরানী ইকরা বোর্ড- নিবন্ধন নং: ৬০২৫৪২</div>
            <div class="inst-line-spacer"></div>
            <div class="phone-badge-single">০১৭২২০৯৫০২৬ (প্রধান শিক্ষক)</div>
          </div>
        </div>
        <div class="header-double-divider"></div>
      </header>

      <div class="editable-body">
        <!-- Blank Canvas for Letters, Notices, and Certificates -->
      </div>
    </div>

    <div class="footer-signatures">
      <div class="sig-grid">
        <div class="sig-col">
          <div class="sig-line">পরিচালক</div>
          <div class="sig-sub">আন্-নূর ইসলামিক একাডেমি</div>
        </div>
        <div class="sig-col">
          <div class="sig-line">প্রতিষ্ঠান প্রধান / সভাপতি</div>
          <div class="sig-sub">আন্-নূর ইসলামিক একাডেমি</div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

</div>
</body>
</html>
